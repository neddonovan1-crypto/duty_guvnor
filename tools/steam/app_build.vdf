"AppBuild"
{
	"AppID" "5018290"
	"Desc" "Duty Guvnor — automated build"
	"BuildOutput" "./output/"
	"ContentRoot" "../../desktop/dist/"
	"SetLive" ""

	"Depots"
	{
		"5018291"
		{
			"FileMapping"
			{
				"LocalPath" "win-unpacked/*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
		"5018292"
		{
			"FileMapping"
			{
				"LocalPath" "linux-unpacked/*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}
